@page "/category/"

@using StoreApp.Client.Components.ComponentFiles.Footer
@using StoreApp.Client.Components.ComponentFiles.Header
@using StoreApp.Client.Components.ComponentFiles.PaginationBar
@using StoreApp.Client.Components.ComponentFiles.Promo
@using StoreApp.Client.Components.ComponentFiles.Separator
@using StoreApp.Client.Components.Pages.Category.Components.Filters
@using StoreApp.Client.Components.Pages.Category.Components.ProductList


<div class="category-page-wrapper">
    <div class="filters-backdrop @( _isFiltersOpen ? "show" : "hide")" @onclick="CloseFilters"></div>
    <div class="filter-wrapper @( _isFiltersOpen ? "show" : "hide")">
        <FiltersComponent IsMobileOverlay="true" OnClose="CloseFilters" />
    </div>
    <div class="products-wrapper">
        <ProductListComponent ProductList="Casual"
                              HeaderText="Casual"
                              OnToggleFilters="ToggleFilters" />
        <div class="separator" />
        <div class="pagination-bar">
            <PaginationBarComponent TotalPages="10" CurrentPage="1" MaxVisiblePages="4" />
        </div>
    </div>
</div>