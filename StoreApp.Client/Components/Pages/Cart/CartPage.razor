@page "/cart"

@using StoreApp.Client.Models


@if (_isLoading)
{
    <div class="loading-indicator">
        <p>Loading...</p>
    </div>
}
else
{
    <div class="cart-page-wrapper">
        <div class="cart-page">
            <div class="cart-title">YOUR CART</div>

            @if (_items.Count == 0)
            {
                <div class="empty-cart">
                    <p>Your cart is empty.</p>
                </div>
            }
            else
            {
                <div class="content">
                    <div class="items">
                        @for (var i = 0; i < _items.Count; i++)
                        {
                            var item = _items[i];
                            <div class="cart-item">
                                <div class="image">
                                    <img src="@item.ProductModel.ImageSrc" alt="@item.ProductModel.Title" />
                                </div>
                                <div class="details">
                                    <div class="title">@item.ProductModel.Title</div>
                                    <div class="meta">$@item.ProductModel.CurrentPrice</div>
                                </div>
                                <div class="actions">
                                    <button class="remove" @onclick="() => RemoveItem(item)">Remove</button>
                                    <div class="quantity">
                                        <button class="qty-btn" @onclick="() => Decrease(item)">−</button>
                                        <div class="qty">@item.Quantity</div>
                                        <button class="qty-btn" @onclick="() => Increase(item)">＋</button>
                                    </div>
                                </div>
                            </div>
                            @if (_items.Count > 1 && i < _items.Count - 1)
                            {
                                <div class="item-separator"></div>
                            }
                        }
                    </div>

                    <div class="summary">
                        <div class="summary-title">Order Summary</div>
                        <div class="row">
                            <div class="row-title">Subtotal</div>
                            <div>$@_subtotal</div>
                        </div>
                        <div class="row">
                            <div class="row-title">Discount (@(_promoApplied ? "-20%" : "0%"))</div>
                            <div class="discount">@(_promoApplied ? $"-$({_discountAmount})" : "$0")</div>
                        </div>
                        <div class="row">
                            <div class="row-title">Delivery Fee</div>
                            <div>$@_deliveryFee</div>
                        </div>
                        <div class="item-separator"></div>
                        <div class="total">
                            <div class="row-title">Total</div>
                            <div>$@_total</div>
                        </div>

                        <div class="promo">
                            <input placeholder="Add promo code" @bind="_promoCode" />
                            <button class="apply" @onclick="ApplyPromoCode">Apply</button>
                        </div>

                        <button class="checkout" @onclick="GoToCheckout">Go to Checkout</button>
                    </div>
                </div>
            }

        </div>
    </div>
}


